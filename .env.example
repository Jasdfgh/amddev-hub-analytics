# Examples only. Enter real values in service-scoped Runtime Secret Groups.
# Never pass these values through Docker build arguments or commit a real .env.
HOST=0.0.0.0
PORT=8080
NODE_ENV=production
# Keep trial data labeled as demo. Switch only with a dedicated real website.
DATA_MODE=demo
PUBLIC_ORIGIN=https://replace-with-service-host.invalid
READ_DATABASE_URL=postgresql://READ_ONLY_USER:REPLACE_WITH_PASSWORD@DATABASE_HOST:5432/umami?sslmode=verify-full
RECEIPT_DATABASE_URL=postgresql://RECEIPT_USER:REPLACE_WITH_PASSWORD@DATABASE_HOST:5432/umami?sslmode=verify-full
# If the provider uses a private CA, mount its CA as a runtime secret file and
# configure the database client's CA trust. Keep hostname/certificate checks on.
UMAMI_URL=http://replace-with-internal-umami-host:3000
UMAMI_WEBSITE_ID=REPLACE_WITH_WEBSITE_UUID
UMAMI_APP_SECRET=REPLACE_WITH_UMAMI_APP_SECRET
VIEWER_USERNAME=hub-viewer
VIEWER_PASSWORD_HASH=scrypt:v1:REPLACE_WITH_BASE64URL_SALT:REPLACE_WITH_BASE64URL_KEY
VIEWER_SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET
COLLECTOR_TOKEN_SECRET=REPLACE_WITH_32_BYTE_BASE64URL_SECRET
COLLECTION_STARTED_AT=REPLACE_WITH_REAL_UTC_COLLECTION_START
HUB_HOSTNAME=replace-with-public-site-host.invalid
ALLOWED_COLLECT_ORIGINS=https://replace-with-public-site-host.invalid
# Set only after verifying the direct platform proxy and forwarded-IP behavior.
TRUSTED_PROXY_IPS=
ALLOW_INTRANET_HTTP=false
ALLOW_TEST_TRAFFIC=false
